# AskFirst — environment configuration
# Copy this file to backend/.env and fill in values before enabling live mode.
# Never commit the real .env file.

# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "true" only after verifying AWS credentials, model access, and billing.
# Default is "false" (sample/mock mode — no AWS calls are made).
LIVE_MODE=false

# ── AWS / Bedrock ──────────────────────────────────────────────────────────────
# Region where your Bedrock model is enabled.
AWS_REGION=us-east-1

# Model ID — confirm availability in your account before enabling live mode.
# Example values (check Bedrock console for your region):
#   us.amazon.nova-lite-v1:0          (Nova Lite — fast, lower cost)
#   us.amazon.nova-pro-v1:0           (Nova Pro — higher capability)
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# AWS credentials — leave blank to use the default boto3 credential chain
# (recommended: use `aws configure` or IAM role instead of hardcoding here).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
# Origin of the React dev server — restrict CORS to this value.
FRONTEND_ORIGIN=http://localhost:5173

# ── Limits (usage controls — not a guaranteed billing cap) ───────────────────
MAX_TOOL_STEPS=6
MAX_TOKENS=1024

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
